        "# ============================================================\n",
        "# EXPERIMENT 2: QUALITY CONTROL AND DATA CLEANING\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate same sample dataset\n",
        "n_cells = 200\n",
        "n_genes = 50\n",
        "\n",
        "genes = [f\"Gene_{i+1}\" for i in range(n_genes)]\n",
        "cells = [f\"Cell_{i+1}\" for i in range(n_cells)]\n",
        "\n",
        "data = np.random.poisson(\n",
        "    lam=5,\n",
        "    size=(n_cells, n_genes)\n",
        ")\n",
        "\n",
        "df = pd.DataFrame(\n",
        "    data,\n",
        "    index=cells,\n",
        "    columns=genes\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# QUALITY CONTROL\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "# Total RNA counts per cell\n",
        "total_counts = df.sum(axis=1)\n",
        "\n",
        "# Number of genes detected in each cell\n",
        "genes_detected = (df > 0).sum(axis=1)\n",
        "\n",
        "print(\"QUALITY CONTROL\")\n",
        "print(\"=\" * 40)\n",
        "\n",
        "print(\"\\nTotal counts per cell:\")\n",
        "display(total_counts.head())\n",
        "\n",
        "print(\"\\nGenes detected per cell:\")\n",
        "display(genes_detected.head())\n",
        "\n",
        "print(\"\\nAverage genes detected:\")\n",
        "print(genes_detected.mean())\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# VISUALIZATION\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "plt.figure(figsize=(10, 5))\n",
        "\n",
        "sns.histplot(\n",
        "    genes_detected,\n",
        "    bins=20\n",
        ")\n",
        "\n",
        "plt.axvline(\n",
        "    30,\n",
        "    linestyle=\"--\",\n",
        "    label=\"QC Threshold\"\n",
        ")\n",
        "\n",
        "plt.title(\"Genes Detected per Cell\")\n",
        "plt.xlabel(\"Number of Genes\")\n",
        "plt.ylabel(\"Number of Cells\")\n",
        "plt.legend()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# FILTER LOW-QUALITY CELLS\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "threshold = 30\n",
        "\n",
        "good_cells = genes_detected >= threshold\n",
        "\n",
        "clean_df = df.loc[good_cells]\n",
        "\n",
        "print(\"\\nOriginal number of cells:\")\n",
        "print(len(df))\n",
        "\n",
        "print(\"\\nCells after quality filtering:\")\n",
        "print(len(clean_df))\n",
        "\n",
        "print(\"\\nRemoved cells:\")\n",
        "print(len(df) - len(clean_df))\n",
        "\n",
        "print(\"\\nCleaned Dataset:\")\n",
        "display(clean_df.head())"
      ]
    }
  ]
